#!/usr/bin/env python3

import atexit
import enum
import os
import pathlib
import re
import readline
import shlex
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from typing import Optional

import click
import rich
import yaml
from rich.panel import Panel
from rich.syntax import Syntax
from rich.table import Table

from dcist_launch_system import fleet_helpers


def _ws_path():
    return pathlib.Path(__file__).absolute().parent.parent


# generate_configs provides the pane shells shared with the generated sessions
sys.path.append(str(_ws_path() / "config_generation"))
import generate_configs  # noqa: E402

ADT4_VARS = [
    "ADT4_ROBOT_NAME",
    "ADT4_PLATFORM_ID",
    "ADT4_OUTPUT_DIR",
    "ADT4_PRIOR_MAP",
    "ADT4_SIM_TIME",
    "ADT4_RVIZ_CONFIG",
    "ADT4_TF_NETWORK_MODE",
    "ADT4_FLEETLINK_MODE",
    "ADT4_FLEETLINK_CONNECT",
]

# Fleet link mode (router | fleetlink) and fleetlink endpoints, derived from
# topology.yaml by fleet_helpers.fleet_link_env. Only the mode can be overridden from
# the environment.
FLEET_VARS = ["ADT4_FLEETLINK_MODE", "ADT4_FLEETLINK_CONNECT", "ADT4_FLEETLINK_PORT"]
# status-monitor entries whose node runs in one fleet link mode only (their panes check
# ADT4_FLEETLINK_MODE); run-adt4 drops them from ADT4_MONITOR_CONFIG in the other mode
MODE_ONLY_NODES = {
    "tf_relay": "router",
    "fleetlink_agent": "fleetlink",
    "fleetlink_bridge": "fleetlink",
}

# rmw_zenohd's default port (topology.yaml zenoh.port, ADT4_ZENOH_PORT override it)
DEFAULT_ZENOH_PORT = 7447

CONSOLE_ENV_VARS = ("ADT4_CONSOLE_TOKEN", "ADT4_CONSOLE_PORT", "ADT4_NETWORK")


class PlatformType(enum.Enum):
    """Enum for platform type."""

    SPOT = "spot"
    PHOENIX = "phoenix"
    BASE_STATION = "base_station"


@dataclass
class SessionInfo:
    """Struct for session config."""

    robot_name: str
    output_path: pathlib.Path
    platform_id: str = ""
    sim_time: bool = False
    session_name: str | None = None
    bag: Optional[pathlib.Path] = None
    bag_delay: float = 5.0
    bag_start: Optional[float] = None
    bag_rate: Optional[float] = None
    trajectory: Optional[pathlib.Path] = None
    trajectory_args: list[str] = field(default_factory=list)
    record: Optional[str] = None
    zenoh: bool = True
    zenoh_port: int = DEFAULT_ZENOH_PORT
    fleet_link: str = "router"
    session_env: dict = field(default_factory=dict)

    @property
    def platform_type(self) -> PlatformType:
        """The platform type inferred from the platform ID."""
        if self.platform_id in ["smaug", "topaz", "apollo"]:
            return PlatformType.SPOT

        if self.platform_id == "base_station":
            return PlatformType.BASE_STATION

        if self.platform_id == "phoenix":
            return PlatformType.PHOENIX

        click.secho("Platform ID '{self.platform_id}' is unknown!", fg="red")
        sys.exit("invalid platform")


def _get_important_experiments():
    manifest_path = _ws_path() / "config_generation" / "experiment_manifest.yaml"
    if not manifest_path.exists():
        click.secho(f"Failed to load manifest from {manifest_path}!", fg="red")

    with manifest_path.open("r") as fin:
        contents = yaml.safe_load(fin)

    return contents.get("important_variants", [])


def _resolve_prior_map(prior_map):
    if prior_map == "???":
        # this only triggers when someone wants to be prompted for a prior map
        # and doesn't want to add it via command line.
        prior_map = input("prior map? ")
        if not prior_map:
            click.secho("No prior map entered! Continuing...", fg="yellow")

    if prior_map:
        prior_map = pathlib.Path(prior_map).expanduser().absolute()
        if not prior_map.exists():
            click.secho(f"Invalid prior map: '{prior_map}'!", fg="red")
            sys.exit("invalid prior map")

    return prior_map


def _show_options(choices, message=None):
    table = rich.table.Table(
        title=message, box=None, show_header=False, title_style="white bold"
    )
    table.add_column("Number", justify="right", style="cyan")
    table.add_column("Name", justify="left")
    for i, x in enumerate(choices):
        table.add_row(f"({i + 1})", x)

    rich.print(table)


def _resolve_session_path(session_path):
    tmux_ws_path = _ws_path() / "tmux" / "autogenerated"
    tmux_files = sorted([x for x in tmux_ws_path.glob("*.yaml")])
    if session_path is None:
        important_names = _get_important_experiments()
        if important_names:
            choice_files = [tmux_ws_path / f"{x}.yaml" for x in important_names]
        else:
            choice_files = tmux_files

        choices = [x.stem for x in choice_files]
        if important_names:
            choices.append("Show all...")

        _show_options(choices)
        idx = click.prompt("What session do you want to load?", default=len(choices))
        if important_names and idx == len(choices):
            choice_files = tmux_files
            _show_options([x.stem for x in choice_files])
            idx = click.prompt("What session do you want to load?", default=1)

        if idx <= 0 or idx > len(choice_files):
            click.secho(f"Invalid session choice: '{idx}'", fg="red")
            sys.exit("invalid session file")

        session_path = choice_files[idx - 1]

    session_path = pathlib.Path(session_path).expanduser()
    if not session_path.suffix:
        session_path = session_path.with_suffix(".yaml")

    session_path = tmux_ws_path / session_path
    if not session_path.exists():
        click.secho(f"Invalid tmuxp file: '{session_path}'!", fg="red")
        _show_options([x.stem for x in tmux_files], message="Available Session Files")
        sys.exit("invalid session file")

    return session_path


def _resolve_output_dir(output_dir, force):
    output_dir = pathlib.Path(output_dir).expanduser().absolute()
    if output_dir.exists():
        if not force:
            click.confirm(f"Output '{output_dir}' exists! Remove?", abort=True)

        click.secho(f"Clearing previous output: '{output_dir}'", fg="green")
        shutil.rmtree(output_dir)

    return output_dir


def _topology_path():
    return _ws_path().parent / "network_diagnostics" / "config" / "topology.yaml"


def _fleet_error(problem):
    click.secho(
        f"Cannot derive the fleet link settings: {problem}. Fix topology.yaml "
        "(or ADT4_TOPOLOGY), or launch in router mode with ADT4_FLEETLINK_MODE=router.",
        fg="red",
    )
    sys.exit(1)


def _fleet_env(robot_name, mode=None):
    """``({ADT4_FLEETLINK_MODE, _CONNECT, _PORT}, topology's mode)`` for this machine.

    Exits with an error when they cannot be derived (unreadable topology, machine not
    in it, fleetlink base without an address on zenoh.fleetlink_networks, unknown
    mode). Router mode needs nothing from the topology but the ports.
    """
    # this checkout's topology (the installed package cannot find it from a
    # non-symlink install); ADT4_TOPOLOGY overrides it
    path = os.environ.get("ADT4_TOPOLOGY") or _topology_path()
    try:
        topology = fleet_helpers.load_topology(path) or {}
    except Exception as e:  # noqa: BLE001
        if mode != "router":
            _fleet_error(f"cannot read {path} ({e})")
        topology = {}
    topo_mode = (topology.get("fleet_defaults") or {}).get("fleet_link") or "router"
    try:
        return fleet_helpers.fleet_link_env(robot_name, topology, mode), topo_mode
    except fleet_helpers.FleetLinkError as e:
        _fleet_error(str(e))


def _derive_fleet_env(env, robot_name, fleet_env=None):
    """Fill ``env`` (in place) with the fleet link vars.

    The mode comes from ``ADT4_FLEETLINK_MODE`` in the launching environment, else
    topology.yaml (a nested run-adt4 inherits its session's mode).
    ``ADT4_FLEETLINK_CONNECT`` / ``_PORT`` always come from topology.yaml for that mode,
    overwriting the environment. All are always set: the tmux session environment
    passes them on, and an unset one would reach the panes as a literal "$VAR".
    """
    fleet_env = fleet_env or _fleet_env
    mode = env.get("ADT4_FLEETLINK_MODE") or None
    derived, topo_mode = fleet_env(robot_name, mode)
    if derived["ADT4_FLEETLINK_MODE"] != topo_mode:
        click.secho(
            f"fleet link mode {derived['ADT4_FLEETLINK_MODE']!r} from the "
            f"environment overrides topology.yaml's {topo_mode!r} (unset "
            "ADT4_FLEETLINK_MODE if that is stale)",
            fg="yellow",
        )
    env.update(derived)


def _session_env(env):
    """run-adt4's fleet link values for the tmux session environment."""
    return {k: env[k] for k in FLEET_VARS if env.get(k)}


def _show_vars(env):
    table = Table(title="Environment Variables")
    table.add_column("Environment Variable", justify="left", style="cyan")
    table.add_column("Value", justify="right")
    for name in ADT4_VARS:
        table.add_row(name, env.get(name) or "---")

    rich.print(table)


SESSION_IDENTITY_VARS = ("config", "logging_key", "sim_time")


def _session_file_env(session_file, env):
    """The session file's ``environment`` values, expanded against ``env`` as tmuxp would.

    tmuxp expands ``$VAR`` in pane commands from the *calling* process environment, not
    the session's ``environment``. A run-adt4 started from a shell inside another ADT4
    tmux session (e.g. the console's) inherits that session's ``config`` /
    ``logging_key`` / ``sim_time``, and every pane then ran with the wrong config (a
    prior_dsg session started its planner with ``conf_name:=default``). Setting the
    session's own values in the tmuxp environment makes the expansion match.
    """
    with open(session_file) as f:
        contents = yaml.safe_load(f) or {}
    out = {}
    for key, value in (contents.get("environment") or {}).items():
        # only the session-identity values a parent ADT4 session leaks; everything else
        # stays for the pane shell to expand (tmuxp would paste values like
        # ADT4_MONITOR_CONFIG's "{...}" raw into commands, a zsh parse error)
        if value is None or key not in SESSION_IDENTITY_VARS:
            continue
        out[str(key)] = re.sub(
            r"\$\{?(\w+)\}?", lambda m: env.get(m.group(1), m.group(0)), str(value)
        )
    return out


def _expand_pane_shells(session_path, env):
    """Expand ``$VAR``s in the session's pane scripts from ``env`` (in place).

    tmuxp expanded typed commands from its own (this) environment; it leaves a pane
    ``shell`` alone, and the pane would read the tmux server's environment instead,
    which is the first session's when another (e.g. adt4_console) started the server.

    A session ``environment`` value that refers to a variable ``env`` does not set
    (e.g. ``HERACLES_EVALUATION_PATH: $ADT4_HERACLES_AGENTS_PATH`` when run-adt4 was
    started without ~/.zshrc, as the console's ssh launch does) would reach every
    pane as the literal "$VAR". Such values are exported by the pane scripts instead,
    after the pane's ~/.zshrc has run, so they expand there.
    """
    with open(session_path) as f:
        contents = yaml.safe_load(f) or {}
    environment = contents.get("environment") or {}
    deferred = {
        key: value
        for key, value in environment.items()
        if value is not None and generate_configs.unresolved_vars(value, env)
    }
    for key in deferred:
        del environment[key]
    # the session's own values win over the launching environment's (tmuxp gives
    # them to the panes): run-adt4 rewrites some (ADT4_MONITOR_CONFIG), and a run-adt4
    # started inside another ADT4 session inherits that session's values
    values = {
        **env,
        **{
            str(k): generate_configs.expand_vars(str(v), env)
            for k, v in environment.items()
            if v is not None
        },
    }
    for window in contents.get("windows") or []:
        for pane in window.get("panes") or []:
            if isinstance(pane, dict) and pane.get("shell"):
                shell = generate_configs.expand_pane_shell(pane["shell"], values)
                pane["shell"] = generate_configs.add_pane_exports(shell, deferred)
    with open(session_path, "w") as f:
        yaml.safe_dump(contents, f, sort_keys=False, width=100000)


def _default_heracles_agents_path(env):
    """ADT4_HERACLES_AGENTS_PATH, else this checkout's heracles_agents submodule."""
    if env.get("ADT4_HERACLES_AGENTS_PATH"):
        return env["ADT4_HERACLES_AGENTS_PATH"]
    path = _ws_path().parent / "heracles_agents"
    return str(path) if path.is_dir() else None


def _run_session(session_path, env, tmuxp_args, dry_run):
    env = {**env, **_session_file_env(session_path, env)}
    # pip --user installs (gauss) put tmuxp in ~/.local/bin, which is not on PATH for
    # the non-interactive ssh command the console launches robots with.
    tmuxp = shutil.which("tmuxp") or shutil.which(
        "tmuxp", path=os.path.expanduser("~/.local/bin")
    )
    if not tmuxp:
        click.secho("tmuxp not found (PATH or ~/.local/bin)", fg="red")
        return 1
    _expand_pane_shells(session_path, env)
    cmd = [tmuxp, "load", str(session_path)]
    if tmuxp_args:
        cmd += shlex.split(tmuxp_args)

    if dry_run:
        click.secho(f"command: {' '.join(cmd)}", fg="green")
        return 0

    return subprocess.run(cmd, env=env).returncode


SETUP_CMD = "source ${ADT4_WS}/install/setup.zsh"


def _make_record_window(info: SessionInfo):
    record_name = info.platform_type.value if info.record == "???" else info.record
    topic_dir = _ws_path() / "recording"
    topic_path = topic_dir / f"{record_name}_topics.txt"
    if not topic_path.exists():
        click.secho(f"Invalid topic file '{topic_path}'!", fg="red")
        avail = [x.stem for x in topic_dir.glob("*_topics.txt")]
        _show_options(avail, message="Available Topic Files")
        sys.exit("invalid record topic file")

    click.secho(f"Recording topics from '{topic_path}'", fg="green")
    output_path = info.output_path / "recorded_data"
    cmd = f"ros2 run dcist_launch_system record_topics {output_path} {topic_path}"
    return {
        "layout": "tiled",
        "panes": [{"shell": generate_configs.pane_shell([SETUP_CMD], cmd)}],
        "window_name": "recording",
    }


def _tf_remap_args(info: SessionInfo):
    # ADT4 namespaces all TF by robot (see master.launch.yaml)
    ns = f"/{info.robot_name}"
    return ["-r", f"/tf:={ns}/tf", "-r", f"/tf_static:={ns}/tf_static"]


def _bag_tf_args(info: SessionInfo):
    """Point ianvs at the bag's TF topics: /<robot>/tf in newer bags, /tf in older ones."""
    bag_dir = info.bag if info.bag.is_dir() else info.bag.parent
    try:
        with (bag_dir / "metadata.yaml").open("r") as fin:
            metadata = yaml.safe_load(fin)["rosbag2_bagfile_information"]
        counts = {
            x["topic_metadata"]["name"]: x["message_count"]
            for x in metadata["topics_with_message_count"]
        }
    except (OSError, KeyError, TypeError, yaml.YAMLError):
        click.secho(f"Could not read bag metadata in '{bag_dir}'", fg="yellow")
        return []

    ns = f"/{info.robot_name}"
    args = []
    if counts.get(f"{ns}/tf", 0) > 0:
        args += ["--tf-topic", f"{ns}/tf"]
    if counts.get(f"{ns}/tf_static", 0) > 0:
        args += ["--tf-static-topic", f"{ns}/tf_static"]

    return args


def _make_bag_window(info: SessionInfo):
    to_drop = [".*leg.*", ".*foot.*", ".*rail.*", ".*map.*"]
    if info.trajectory:
        to_drop.append(".*odom.*")

    bag_args = ["--filter-tf", "-k", f"'.*{info.robot_name}.*'"]
    bag_args += _bag_tf_args(info)
    bag_args += ["--delay", str(info.bag_delay)]
    bag_args += [f"-f '{x}'" for x in to_drop]
    if info.sim_time:
        bag_args.append("--clock")

    if info.bag_start:
        bag_args += ["--start-offset", f"{info.bag_start}"]

    if info.bag_rate:
        bag_args += ["--rate", f"{info.bag_rate}"]

    # play_rosbag republishes (filtered) TF from its wrapper node, which these remaps move
    bag_args += ["--ros-args"] + _tf_remap_args(info)

    # Every pane runs as its own process (pane `shell`, see
    # generate_configs.pane_shell) instead of having its command typed into a
    # shell that may not be ready yet; the pane stays an interactive shell after.
    play_cmd = f"ros2 run ianvs play_rosbag {info.bag} {' '.join(bag_args)}"
    window_config = {
        "layout": "tiled",
        "panes": [{"shell": generate_configs.pane_shell([SETUP_CMD], play_cmd)}],
        "window_name": "play_rosbag",
    }
    if info.trajectory:
        is_spot = info.platform_id in ["topaz", "smaug", "apollo"]
        child_frame = f"{info.robot_name}/" + ("body" if is_spot else "base_link")
        cmd = ["ros2", "run", "ianvs", "csv_to_tf", f"{info.trajectory}"]
        cmd += ["--parent", f"{info.robot_name}/odom", "--child", child_frame]
        cmd += info.trajectory_args
        cmd += ["--ros-args", "-p", "use_sim_time:=true"] + _tf_remap_args(info)
        window_config["panes"].append(
            {"shell": generate_configs.pane_shell([SETUP_CMD], " ".join(cmd))}
        )

    return window_config


# In fleetlink mode only fleetlink crosses the radio, so the local rmw_zenohd must
# not dial other machines. ~/.zshrc often points ZENOH_ROUTER_CONFIG_URI at a fleet
# config whose connect endpoints are the other routers; clear them
# (ZENOH_CONFIG_OVERRIDE: ';'-separated key=JSON5 pairs applied over that file).
FLEETLINK_ZENOH_OVERRIDE = "connect/endpoints=[]"


def _zenoh_port(env):
    """The local rmw_zenohd's port: ADT4_ZENOH_PORT, else topology.yaml's zenoh.port."""
    if env.get("ADT4_ZENOH_PORT"):
        return int(env["ADT4_ZENOH_PORT"])
    try:
        topology = fleet_helpers.load_topology(
            env.get("ADT4_TOPOLOGY") or _topology_path()
        )
        return int(
            ((topology or {}).get("zenoh") or {}).get("port", DEFAULT_ZENOH_PORT)
        )
    except Exception:  # noqa: BLE001
        return DEFAULT_ZENOH_PORT


def _zenoh_cmd(fleet_link, port=DEFAULT_ZENOH_PORT):
    """Start rmw_zenohd, unless a router already listens on ``port``.

    Another session (start-adt4-console's adt4_console, or another team's router on a
    shared machine) may already run one; a second would only fail with "Address
    already in use", so say so instead (the same check as fleetlink_base.yaml's).
    """
    cmd = "ros2 run rmw_zenoh_cpp rmw_zenohd"
    if fleet_link == "fleetlink":
        cmd = f"ZENOH_CONFIG_OVERRIDE={shlex.quote(FLEETLINK_ZENOH_OVERRIDE)} {cmd}"
    return (
        f'if ss -ltn | grep -q ":{port} "; then echo "zenoh router already running on '
        f"port {port} (another session, e.g. adt4_console from start-adt4-console?), "
        f'not starting another"; else {cmd}; fi'
    )


def _make_zenoh_window(fleet_link="router", port=DEFAULT_ZENOH_PORT):
    return {
        "layout": "tiled",
        "panes": [
            {
                "shell": generate_configs.pane_shell(
                    [SETUP_CMD], _zenoh_cmd(fleet_link, port)
                )
            }
        ],
        "window_name": "zenoh",
    }


def _monitor_config(monitor, fleet_link):
    """ADT4_MONITOR_CONFIG without the nodes that do not run in ``fleet_link`` mode."""
    config = yaml.safe_load(monitor) or {}
    nodes = config.get("nodes_to_track") or {}
    keep = {
        name: entry
        for name, entry in nodes.items()
        if MODE_ONLY_NODES.get(name, fleet_link) == fleet_link
    }
    if len(keep) == len(nodes):
        return monitor
    config["nodes_to_track"] = keep
    return yaml.dump(config, default_flow_style=True, width=800).strip("\n")


def _write_session_to_file(session_path, info: SessionInfo, fout, verbose=False):
    with session_path.open("r") as fin:
        contents = yaml.safe_load(fin.read())

    if info.bag:
        contents["windows"].append(_make_bag_window(info))

    if info.record:
        contents["windows"].append(_make_record_window(info))

    if info.zenoh:
        contents["windows"] = [
            _make_zenoh_window(info.fleet_link, info.zenoh_port)
        ] + contents["windows"]

    # the fleet link values reach every session (e.g. tf_relay reads the mode),
    # whatever its components declare
    contents.setdefault("environment", {})
    contents["environment"].update(info.session_env)
    monitor = contents["environment"].get("ADT4_MONITOR_CONFIG")
    if monitor:
        contents["environment"]["ADT4_MONITOR_CONFIG"] = _monitor_config(
            monitor, info.fleet_link
        )

    if info.session_name:
        contents["session_name"] = info.session_name

    if any(w.get("window_name") == "console" for w in contents["windows"]):
        # A pre-existing tmux server keeps its own environment. Explicitly forward
        # these optional settings, including empty values to clear stale settings.
        contents.setdefault("environment", {}).update(
            {name: os.environ.get(name, "") for name in CONSOLE_ENV_VARS}
        )

    fout.write(yaml.dump(contents, width=300))
    fout.flush()

    if verbose:
        if contents.get("environment", {}).get("ADT4_CONSOLE_TOKEN"):
            contents["environment"]["ADT4_CONSOLE_TOKEN"] = "<redacted>"
        console = rich.console.Console()
        console.print(Panel(Syntax(yaml.dump(contents, width=300), "yaml")))


@click.command()
@click.argument("session_path", type=click.Path(), default=None, required=False)
@click.option("--tmuxp-args", default=None, help="args to forward to tmuxp")
@click.option("--robot-name", "-n", envvar="ADT4_ROBOT_NAME", help="robot name to use")
@click.option(
    "--platform-id",
    "-c",
    envvar="ADT4_PLATFORM_ID",
    help="robot platform adt4 is running on",
)
@click.option(
    "--output-dir",
    "-o",
    envvar="ADT4_OUTPUT_DIR",
    type=click.Path(),
    help="output for adt4",
)
@click.option(
    "--prior-map",
    "-p",
    envvar="ADT4_PRIOR_MAP",
    help="prior map",
    is_flag=False,
    flag_value="???",
    type=click.Path(),
)
@click.option("--sim-time", "-s", is_flag=True, help="use sim time")
@click.option("--yes", "-y", is_flag=True, help="skip env variable check")
@click.option("--force", "-f", is_flag=True, help="clear output if it exists")
@click.option("--dry-run", "-d", is_flag=True, help="only show command")
@click.option("--tmuxp-session-name", help="name to use instead of adt4_system")
@click.option("--show-tmux", is_flag=True, help="show tmuxp contents before starting")
@click.option("--bag", default=None, type=click.Path(exists=True), help="bag to run")
@click.option("--bag-delay", default=5.0, help="bag playback delay")
@click.option("--bag-start", type=float, help="bag start offset")
@click.option("--bag-rate", type=float, help="bag playback rate")
@click.option(
    "--trajectory",
    "-t",
    default=None,
    type=click.Path(exists=True, dir_okay=False),
    help="trajectory to use when replaying bag",
)
@click.option(
    "--trajectory-args", default=None, help="args to forward to csv publisher"
)
@click.option("--record", "-r", is_flag=False, flag_value="???")
@click.option(
    "--rviz-config",
    envvar="ADT4_RVIZ_CONFIG",
    type=click.Path(),
    default=None,
    help="custom rviz config file (overrides default dcist.rviz)",
)
@click.option("--zenoh/--no-zenoh", default=True, help="start zenoh router")
@click.option(
    "--forward-all-tf",
    is_flag=True,
    help="send the robot's whole TF tree to the base station (default: only map_T_robot)",
)
def main(
    session_path,
    tmuxp_args,
    robot_name,
    platform_id,
    output_dir,
    prior_map,
    sim_time,
    yes,
    force,
    dry_run,
    tmuxp_session_name,
    show_tmux,
    bag,
    bag_delay,
    bag_start,
    bag_rate,
    trajectory,
    trajectory_args,
    record,
    rviz_config,
    zenoh,
    forward_all_tf,
):
    robot_name = robot_name or input("robot name to use? ")
    platform_id = platform_id or input("robot platform ID? ")
    output_dir = output_dir or input("output directory? ")

    prior_map = _resolve_prior_map(prior_map)
    session_path = _resolve_session_path(session_path)
    output_dir = _resolve_output_dir(output_dir, force)

    def _normalize_optional(opt_path: Optional[str]):
        return pathlib.Path(opt_path).expanduser().absolute() if opt_path else None

    env = os.environ.copy()
    env["ADT4_ROBOT_NAME"] = robot_name
    env["ADT4_PLATFORM_ID"] = platform_id
    env["ADT4_SIM_TIME"] = "true" if sim_time else "false"
    env["ADT4_TF_NETWORK_MODE"] = "all" if forward_all_tf else "frames"
    env["ADT4_OUTPUT_DIR"] = str(output_dir)
    # always set: the session files pass ADT4_PRIOR_MAP: $ADT4_PRIOR_MAP, and tmuxp leaves an
    # unset variable as the literal "$ADT4_PRIOR_MAP", which ${ADT4_PRIOR_MAP:+...} reads as set
    env["ADT4_PRIOR_MAP"] = str(prior_map) if prior_map else ""
    # sessions pass HERACLES_EVALUATION_PATH: $ADT4_HERACLES_AGENTS_PATH; ~/.zshrc usually
    # exports it, but a launch without ~/.zshrc (console ssh, zsh -c) does not
    heracles_agents = _default_heracles_agents_path(env)
    if heracles_agents:
        env["ADT4_HERACLES_AGENTS_PATH"] = heracles_agents
    _derive_fleet_env(env, robot_name)

    if rviz_config:
        rviz_config = pathlib.Path(rviz_config).expanduser().absolute()
        if rviz_config.exists():
            env["ADT4_RVIZ_CONFIG"] = str(rviz_config)
        else:
            click.secho(f"Bad rviz config: '{rviz_config}', using default", fg="yellow")

    click.secho(f"Loading {session_path}...")
    _show_vars(env)
    if not yes:
        click.confirm("Are the settings correct?", abort=True)

    info = SessionInfo(
        robot_name,
        output_dir,
        platform_id=platform_id,
        sim_time=sim_time,
        session_name=tmuxp_session_name,
        bag=_normalize_optional(bag),
        bag_delay=bag_delay,
        bag_start=bag_start,
        bag_rate=bag_rate,
        trajectory=_normalize_optional(trajectory),
        record=record,
        zenoh=zenoh,
        zenoh_port=_zenoh_port(env),
        fleet_link=env["ADT4_FLEETLINK_MODE"],
        session_env=_session_env(env),
    )
    if trajectory_args:
        info.trajectory_args = trajectory_args.split(" ")

    with tempfile.NamedTemporaryFile("w+", suffix=".yaml") as fout:
        _write_session_to_file(session_path, info, fout, verbose=dry_run or show_tmux)
        return _run_session(fout.name, env, tmuxp_args, dry_run)


if __name__ == "__main__":
    readline_history = pathlib.Path("~/.adt4_history").expanduser().absolute()
    if readline_history.exists():
        readline.read_history_file(str(readline_history))

    readline.set_history_length(1000)
    atexit.register(readline.write_history_file, readline_history)
    sys.exit(main())
