<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adt4_console</name>
  <version>0.1.0</version>
  <description>ADT4 web console: a browser viewer for scene graphs from Neo4j (heracles) or run directories, with mesh, object images, keyframes and a satellite underlay.</description>
  <maintainer email="harelb@mit.edu">harel</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>spark_dsg</exec_depend>
  <exec_depend>heracles</exec_depend>
  <!-- hydra_python.image_store: object / keyframe images -->
  <exec_depend>hydra</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
